# VibeTalk Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it is in .gitignore.

# ── Firebase ─────────────────────────────────────────────────────────
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_APP_ID=your_firebase_app_id_here
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# ── API ──────────────────────────────────────────────────────────────
API_BASE_URL=https://api.vibetalk.app

# ── Cloudflare R2 ───────────────────────────────────────────────────
CLOUDFLARE_R2_BUCKET=vibetalk-media
CLOUDFLARE_R2_ACCESS_KEY=your_r2_access_key_here
CLOUDFLARE_R2_SECRET_KEY=your_r2_secret_key_here
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ── Sentry ───────────────────────────────────────────────────────────
SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id
