# VibeTalk Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is in .gitignore.

# ── Server ───────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (PostgreSQL via Supabase) ───────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# ── Cache (Redis via Upstash) ────────────────────────────────────────
REDIS_URL=rediss://default:your_password@your-endpoint.upstash.io:6379

# ── JWT Secrets ──────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars

# ── Firebase Admin SDK ───────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ── Cloudflare R2 (S3-compatible Object Storage) ────────────────────
CLOUDFLARE_R2_BUCKET=vibetalk-media
CLOUDFLARE_R2_ACCESS_KEY=your_r2_access_key_here
CLOUDFLARE_R2_SECRET_KEY=your_r2_secret_key_here
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ── Sentry (Error Tracking) ─────────────────────────────────────────
SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id
